# ============================================================
# KisanSetu AI — Environment Configuration Template (.env.example)
# Copy this file to .env (and/or frontend/.env.local) and fill in your values.
# NEVER commit your real .env file with secrets into version control!
# ============================================================

# ------------------------------------------------------------
# 1. Environment & Server Settings
# ------------------------------------------------------------
ENVIRONMENT=development               # Options: development, staging, production
DEBUG=true                            # Set to false in production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ------------------------------------------------------------
# 2. Database Settings
# ------------------------------------------------------------
# Local SQLite fallback (Zero setup needed):
DATABASE_URL=sqlite+aiosqlite:///./kisansetu.db

# Production PostgreSQL (Uncomment and replace with your credentials):
# DATABASE_URL=postgresql+asyncpg://kisansetu:YOUR_STRONG_PASSWORD@localhost:5432/kisansetu_db

# ------------------------------------------------------------
# 3. Security & Authentication (CRITICAL)
# ------------------------------------------------------------
# Generate a secure 32+ char secret in terminal with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_secret_key_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440      # 24 Hours

# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# ------------------------------------------------------------
# 4. Frontend Configuration (Public)
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ------------------------------------------------------------
# 5. OTP & SMS Notification Gateway
# ------------------------------------------------------------
# Demo/development OTP code (used when SMS_PROVIDER is SIMULATED)
DEMO_OTP=
# SMS_PROVIDER options:
#   SIMULATED    — logs to console only (default/dev, no hardware needed)
#   ADB          — USB-connected Android phone via Termux:API (free, local, no cloud)
#   MSG91        — MSG91 cloud gateway (production, free 100 SMS/day)
SMS_PROVIDER=SIMULATED
SMS_API_KEY=
SMS_SENDER_ID=KSTUAI

# ADB/Termux SMS Setup (used when SMS_PROVIDER=ADB):
#   1. Enable USB Debugging on your Android phone
#   2. Install Termux from F-Droid: https://f-droid.org/en/packages/com.termux/
#   3. Install Termux:API from F-Droid: https://f-droid.org/en/packages/com.termux.api/
#   4. Open Termux and run: pkg install termux-api
#   5. Grant SMS permission to Termux:API when prompted
#   6. Plug phone into PC via USB and authorize ADB on the phone
#   7. Verify with: adb devices  (phone should be listed)
#   No extra env vars needed — just set SMS_PROVIDER=ADB above

# ------------------------------------------------------------
# 6. Demo Mode & Credentials (Disable in production)
# ------------------------------------------------------------
DEMO_MODE=true                        # Set to false to completely disable /auth/demo-login
DEMO_FARMER_EMAIL=demo.farmer@example.com
DEMO_FARMER_PASSWORD=
DEMO_OFFICER_EMAIL=demo.officer@example.com
DEMO_OFFICER_PASSWORD=
DEMO_ADMIN_EMAIL=demo.admin@example.com
DEMO_ADMIN_PASSWORD=

# ------------------------------------------------------------
# 7. Docker Compose PostgreSQL Credentials
# ------------------------------------------------------------
POSTGRES_DB=kisansetu_db
POSTGRES_USER=kisansetu
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# ------------------------------------------------------------
# 8. Data Pipeline — Government Data Acquisition
# ------------------------------------------------------------
# Optional: data.gov.in API key for live real-time mandi prices
# (used by agmarknet_service.py for live price lookups, NOT for batch downloads)
# Get a free key at: https://data.gov.in/apis
DATA_GOV_IN_API_KEY=

# Optional: Kaggle credentials for batch Agmarknet dataset download
# Instructions: https://github.com/Kaggle/kaggle-api#api-credentials
# Place kaggle.json in ~/.kaggle/ OR set these two vars:
KAGGLE_USERNAME=
KAGGLE_KEY=

# Data pipeline configuration
DATA_DIR=data
DATA_SEED=42                          # Reproducibility seed for synthetic data
