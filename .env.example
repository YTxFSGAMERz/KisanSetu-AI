# ============================================================
# KisanSetu AI — Environment Configuration Template (.env.example)
# Copy this file to .env (and/or frontend/.env.local) and fill in your values.
# NEVER commit your real .env file with secrets into version control!
# ============================================================

# ------------------------------------------------------------
# 1. Environment & Server Settings
# ------------------------------------------------------------
ENVIRONMENT=development               # Options: development, staging, production
DEBUG=true                            # Set to false in production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ------------------------------------------------------------
# 2. Database Settings
# ------------------------------------------------------------
# Local SQLite fallback (Zero setup needed):
DATABASE_URL=sqlite+aiosqlite:///./kisansetu.db

# Production PostgreSQL (Uncomment and replace with your credentials):
# DATABASE_URL=postgresql+asyncpg://kisansetu:YOUR_STRONG_PASSWORD@localhost:5432/kisansetu_db

# ------------------------------------------------------------
# 3. Security & Authentication (CRITICAL)
# ------------------------------------------------------------
# Generate a secure 32+ char secret in terminal with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_secret_key_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440      # 24 Hours

# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# ------------------------------------------------------------
# 4. Frontend Configuration (Public)
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ------------------------------------------------------------
# 5. OTP & SMS Notification Gateway
# ------------------------------------------------------------
# Demo/development OTP code (used when SMS_PROVIDER is SIMULATED)
DEMO_OTP=
SMS_PROVIDER=SIMULATED                # Options: SIMULATED, TWILIO, MSG91
SMS_API_KEY=
SMS_SENDER_ID=KSTUAI

# ------------------------------------------------------------
# 6. Demo Mode & Credentials (Disable in production)
# ------------------------------------------------------------
DEMO_MODE=true                        # Set to false to completely disable /auth/demo-login
DEMO_FARMER_EMAIL=demo.farmer@example.com
DEMO_FARMER_PASSWORD=
DEMO_OFFICER_EMAIL=demo.officer@example.com
DEMO_OFFICER_PASSWORD=
DEMO_ADMIN_EMAIL=demo.admin@example.com
DEMO_ADMIN_PASSWORD=

# ------------------------------------------------------------
# 7. Docker Compose PostgreSQL Credentials
# ------------------------------------------------------------
POSTGRES_DB=kisansetu_db
POSTGRES_USER=kisansetu
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
